    journal: "ACS Materials Letters"
    volume: 6
    issue: 11
    start: 5138
    end: 5145
    year: 2024
    doi: "10.1021/acsmaterialslett.4c01367"
    url: "https://doi.org/10.1021/acsmaterialslett.4c01367"
